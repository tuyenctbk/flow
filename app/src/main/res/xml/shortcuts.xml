<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="start_flow"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_flow"
        android:shortcutShortLabel="@string/shortcut_start_flow_short"
        android:shortcutLongLabel="@string/shortcut_start_flow_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.example.MainActivity">
            <extra
                android:name="com.example.ACTION_SHORTCUT"
                android:value="start_flow" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="add_reflection"
