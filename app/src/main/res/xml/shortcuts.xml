            android:action="android.intent.action.VIEW"
            android:targetClass="com.example.MainActivity">
            <extra
                android:name="com.example.ACTION_SHORTCUT"
                android:value="add_reflection" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="open_stats"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_stats"
        android:shortcutShortLabel="@string/shortcut_open_stats_short"
        android:shortcutLongLabel="@string/shortcut_open_stats_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.example.MainActivity">
            <extra
                android:name="com.example.ACTION_SHORTCUT"
